<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ALTRAFLOAT.Views.AgentLoginPage"
             BackgroundColor="#443123"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="AltraBrown">#443123</Color>
            <Color x:Key="AltraBrownDark">#3D2B20</Color>
            <Color x:Key="AltraYellow">#FFC400</Color>
            <Color x:Key="AltraYellowDark">#E6B000</Color>
            <Color x:Key="AltraCard">#514034</Color>
            <Color x:Key="AltraCardLight">#F8F5F2</Color>
            <Color x:Key="AltraWhite">#FFFFFF</Color>
            <Color x:Key="AltraMuted">#C7BDB5</Color>
            <Color x:Key="AltraStroke">#665448</Color>
            <Color x:Key="AltraDarkText">#493629</Color>
            <Color x:Key="AltraFieldStroke">#E5DFD9</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <BoxView Color="{StaticResource AltraYellow}"
                 WidthRequest="180" HeightRequest="180"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 Rotation="-45" TranslationX="-70" TranslationY="-70"
                 Opacity="0.9"/>
        <ScrollView>
            <VerticalStackLayout Padding="24,34,24,28" Spacing="0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,18,0,8">
                    <Image Source="altrafloat_logo.png" WidthRequest="58" HeightRequest="58"
                           Aspect="AspectFit" VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label FontSize="27" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Altra" TextColor="White"/>
                                    <Span Text="float" TextColor="{StaticResource AltraYellow}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="Agent &amp; Liquidity Officer Communication"
                               FontSize="10" TextColor="{StaticResource AltraMuted}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="26,28"
                        Margin="0,26,0,0">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Welcome Back" FontSize="25" FontAttributes="Bold"
                                   TextColor="{StaticResource AltraDarkText}" HorizontalOptions="Center"/>
                            <Label Text="Sign in to your Altrafloat account" FontSize="13"
                                   TextColor="#8A7F76" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#F0EDE9" StrokeThickness="0"
                                StrokeShape="RoundRectangle 24" Padding="4" Margin="0,6,0,2">
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Text="Agent Login"
                                        BackgroundColor="{StaticResource AltraBrown}"
                                        TextColor="{StaticResource AltraYellow}"
                                        FontAttributes="Bold" FontSize="12"
                                        CornerRadius="20" HeightRequest="44"
                                        Clicked="OnAgentTabClicked"/>
                                <Button Grid.Column="1" Text="Liquidity Officer Login"
                                        BackgroundColor="Transparent"
                                        TextColor="#5C534C"
                                        FontAttributes="Bold" FontSize="12"
                                        CornerRadius="20" HeightRequest="44"
                                        Clicked="OnLiquidityTabClicked"/>
                            </Grid>
                        </Border>

                        <Border Stroke="{StaticResource AltraFieldStroke}" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14" Padding="15,4" BackgroundColor="White">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Email Address" FontSize="11" TextColor="#9A9088"/>
                                <Entry x:Name="EmailEntry" Placeholder="Enter your email address"
                                       Keyboard="Email" PlaceholderColor="#C4BDB6"
                                       TextColor="{StaticResource AltraDarkText}"
                                       BackgroundColor="Transparent" HeightRequest="38"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="{StaticResource AltraFieldStroke}" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14" Padding="15,4" BackgroundColor="White">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="User Name" FontSize="11" TextColor="#9A9088"/>
                                <Entry x:Name="UsernameEntry" Placeholder="Enter your user name" PlaceholderColor="#C4BDB6"
                                       TextColor="{StaticResource AltraDarkText}" BackgroundColor="Transparent"
                                       HeightRequest="38"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="{StaticResource AltraFieldStroke}" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14" Padding="15,4" BackgroundColor="White">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Agent ID" FontSize="11" TextColor="#9A9088"/>
                                <Entry x:Name="AgentIdEntry" Placeholder="Example: G1001" PlaceholderColor="#C4BDB6"
                                       TextColor="{StaticResource AltraDarkText}" BackgroundColor="Transparent"
                                       HeightRequest="38"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="{StaticResource AltraFieldStroke}" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14" Padding="15,4" BackgroundColor="White">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Agent Category" FontSize="11" TextColor="#9A9088"/>
                                <Picker x:Name="AgentCategoryPicker" Title="Select Agent Category" TitleColor="#C4BDB6"
                                        TextColor="{StaticResource AltraDarkText}" BackgroundColor="Transparent"
                                        HeightRequest="42">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Main Agent</x:String>
                                            <x:String>Moblie Money Agent</x:String>
                                            <x:String>High Agents</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="{StaticResource AltraFieldStroke}" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14" Padding="15,4" BackgroundColor="White">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Password" FontSize="11" TextColor="#9A9088"/>
                                <Entry x:Name="PasswordEntry" Placeholder="Enter your password" IsPassword="True"
                                       PlaceholderColor="#C4BDB6" TextColor="{StaticResource AltraDarkText}"
                                       BackgroundColor="Transparent" HeightRequest="38"/>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Login  →" Clicked="OnLoginClicked" BackgroundColor="{StaticResource AltraBrown}"
                                TextColor="{StaticResource AltraYellow}" FontAttributes="Bold"
                                FontSize="16" HeightRequest="52" CornerRadius="14" Margin="0,6,0,0"/>
                        <Label x:Name="ForgotPasswordLabel" Text="Forgot Password?" TextColor="{StaticResource AltraDarkText}"
                               FontAttributes="Bold" HorizontalOptions="Center"
                               TextDecorations="Underline" Margin="0,2,0,0"/>
                        <Label Text="OR" TextColor="#A89F96" HorizontalOptions="Center" FontSize="12"/>
                        <Border Stroke="{StaticResource AltraFieldStroke}" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14" Padding="14,14" BackgroundColor="White">
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Don't have an account? " TextColor="#5C534C"/>
                                        <Span x:Name="CreateAccountSpan" Text="Create Account" TextColor="{StaticResource AltraDarkText}"
                                              FontAttributes="Bold"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Border>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Secure • Reliable • Altrafloat" TextColor="{StaticResource AltraMuted}"
                       HorizontalOptions="Center" FontSize="12" Margin="0,24,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
