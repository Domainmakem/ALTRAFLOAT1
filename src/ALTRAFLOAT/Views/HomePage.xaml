<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ALTRAFLOAT.Views.HomePage"
             Title="Home">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="TextLight">#14211C</Color>
            <Color x:Key="TextDark">#F4F7F5</Color>
            <Color x:Key="MutedLight">#4E655C</Color>
            <Color x:Key="MutedDark">#B7C9C1</Color>

            <Style x:Key="Headline" TargetType="Label">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>

            <Style x:Key="SubHeadline" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
            <Label Text="ALTRAFLOAT"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Status}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />
            <Button Text="Tap"
                    Command="{Binding IncrementCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
